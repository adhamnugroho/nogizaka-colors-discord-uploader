# ==============================================================================
# DISCORD WEBHOOK CONFIGURATION
# ==============================================================================
# Salin file ini menjadi .env dan isi dengan webhook asli Anda:
#   cp .env.example .env  (Linux/macOS) atau Copy-Item .env.example .env (Windows)
# JANGAN PERNAH meng-commit file .env yang berisi token asli ke GitHub!

# URL Webhook Discord (Pengaturan Channel -> Integrations -> Webhooks -> Copy Webhook URL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789012345678/your_webhook_token_here

# ID Thread Discord target (Klik kanan thread -> Copy Thread ID, perlu Developer Mode aktif)
DISCORD_THREAD_ID=123456789012345678

# ==============================================================================
# OPTIONAL TUNING PARAMETERS
# ==============================================================================
# Jeda antar pengiriman batch dalam detik (default: 2.0 detik)
RATE_LIMIT_DELAY=2.0

# Jumlah foto maksimal per satu pesan Discord (default: 6 foto)
MAX_BATCH_FILES=6

# Ambang batas payload upload per pesan dalam bytes (default: 8500000 ~ 8.5 MB)
MAX_BATCH_BYTES=8500000
